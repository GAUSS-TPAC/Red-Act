{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "infra/bin",
    "infra/lib",
    "infra/test",
    "scripts",
    "tests",
    "vitest.config.ts"
  ],
  "exclude": [
    "packages/web"
  ]
}
