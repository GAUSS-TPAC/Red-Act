{
  "name": "editeur-partage",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "infra"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "local:db": "docker compose up -d dynamodb-local",
    "local:db:stop": "docker compose down",
    "local:tables": "node scripts/run-ts.mjs scripts/create-local-tables.ts",
    "synth": "npm run build && npm --workspace infra run synth"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "4.1.12"
  }
}
